#!/usr/bin/env python3
import json
import os
import sys

argv = sys.argv[1:]
src, dst = argv[-2], argv[-1]
e = argv[argv.index("-e") + 1] if "-e" in argv else ""
with open(os.environ["FAKE_RSYNC_LOG"], "a") as f:
    f.write(json.dumps({"src": src, "dst": dst, "e": e}) + "\n")
if "@" in src and ":" in src:
    if src.endswith("/run/boxes/") and os.environ.get("FAKE_RSYNC_NO_BOXES"):
        sys.stderr.write('rsync: [sender] change_dir "/opt/botsim/run/boxes" failed: No such file or directory (2)\nrsync error: some files/attrs were not transferred (see previous errors) (code 23)\n')
        sys.exit(23)
    os.makedirs(dst, exist_ok=True)
    name = "metrics.jsonl" if not src.endswith("/boxes/") else "collected.txt"
    open(os.path.join(dst, name), "w").write('{"games": 1}\n')
sys.exit(0)
